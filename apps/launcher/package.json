{
  "name": "@rustic/launcher",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "videos": "playwright test --project=screenshots journeys-video && node scripts/encode-videos.mjs && node scripts/export-stills.mjs",
    "gen:cloud": "openapi-typescript ../../crates/rusticmc-api-client/openapi.json -o src/cloud/generated/schema.d.ts",
    "gen:ipc-doc": "node scripts/gen-ipc-doc.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@rustic/locales": "workspace:*",
    "@rustic/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tauri-apps/api": "2.12.4",
    "i18next": "27.1.0",
    "lucide-react": "1.70.0",
    "motion": "14.11.1",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
